{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Companion",
  "version": "0.1.0",
  "identifier": "com.kokuren.researchcompanion",
  "build": {
    "frontendDist": "../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Research Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "resources": ["backend/research-companion-backend.exe"]
  }
}
